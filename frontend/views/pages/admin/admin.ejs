                  <input
                    type="file"
                    id="update-product-image-file-0"
                    name="file"
                  />
                  <label for="update-product-image-file-0">
                    <i class="bx bx-image-add"></i>Change Image
                  </label>
                </div>
                <div class="img-div"></div>
              </div>
              <div class="small-img-div">
                <div class="small-imgs">
                  <div class="small-img">
                    <div class="no-img-div">
                      <input
                        type="file"
                        name="file"
                        id="update-product-image-file-1"
                      />
                      <label for="update-product-image-file-1">
