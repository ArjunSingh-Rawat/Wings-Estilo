<!doctype html>
<html lang="en">
  <head>
    <%-include("../../partials/head")%>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <%-include("../../partials/header")%>

    <!-- product-img-section -->
    <section class="product-img-section">
      <h1>Add Product Images</h1>
      <div class="add-img-div">
        <div class="main-img-div">
          <label for="file">
            <i class="bx bx-image-add"></i>
          </label>
          <input type="file" id="file" />
        </div>
        <div class="small-img-div">
          <div class="small-imgs">
            <div class="small-img">
              <label for="file">
                <i class="bx bx-image-add"></i>
              </label>
              <input type="file" id="file" />
            </div>
            <div class="small-img">
              <label for="file">
                <i class="bx bx-image-add"></i>
              </label>
              <input type="file" id="file" />
            </div>
            <div class="small-img">
              <label for="file">
                <i class="bx bx-image-add"></i>
              </label>
              <input type="file" id="file" />
            </div>
            <div class="small-img">
              <label for="file">
                <i class="bx bx-image-add"></i>
              </label>
              <input type="file" id="file" />
            </div>
            <div class="small-img">
              <label for="file">
                <i class="bx bx-image-add"></i>
              </label>
              <input type="file" id="file" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- product-info-section -->
    <section class="product-info-section">
      <h1>Add Product Information</h1>
      <form id="product-info-form" action="">
        <!-- form-left-div -->
        <div class="form-left-div">
          <!-- product-name -->
          <div class="add-product-name">
            <label for="product-name">Add product name:</label>
            <input type="text" id="product-name" name="product-name" />
          </div>

          <!-- sell-rent -->
          <div class="rent-sell">
            <div class="sell">
              <input type="checkbox" id="sell" name="sell" value="sell" />
              <label for="vehicle1">For selling</label>
            </div>
            <div class="rent">
              <input type="checkbox" id="rent" name="rent" value="rent" />
              <label for="rent">For rental</label>
            </div>
          </div>

          <!-- product-price -->
          <div class="product-price">
            <div class="add-product-price">
              <label for="product-price">Add selling product price:</label>
              <input type="text" id="product-price" name="product-price" />
            </div>
            <div class="add-product-price">
              <label for="product-price">Add rental product price:</label>
              <input type="text" id="product-price" name="product-price" />
            </div>
          </div>

          <!-- product-category -->
          <div class="product-category">
            <div class="main-category">
              <label for="main-category">Select category:</label>
              <select id="main-category" name="main-category">
                <option value="volvo">--Select category--</option>
                <option value="saab">Saab</option>
                <option value="fiat">Fiat</option>
                <option value="audi">Audi</option>
              </select>
            </div>

            <div class="sub-category">
              <label for="sub-category">Select sub category:</label>
              <select id="sub-category" name="sub-category">
                <option value="volvo">--Select sub category--</option>
                <option value="saab">Saab</option>
                <option value="fiat">Fiat</option>
                <option value="audi">Audi</option>
              </select>
            </div>
          </div>
        </div>

        <!-- form-right-div -->
        <div class="form-right-div">
          <div class="product-description">
            <div class="short-description">
              <label for="short-description">Add short-description:</label>
              <textarea
                id="short-description"
                name="short-description"
              ></textarea>
            </div>

            <div class="main-description">
              <label for="main-description">Add description:</label>
              <textarea
                id="main-description"
                name="main-description"
              ></textarea>
            </div>
          </div>

          <div class="product-size">
            <p id="size-title">Product quantity in size:</p>

            <div class="sizes">
              <div class="size">
                <label for="size">S</label>
                <input type="text" id="size" name="size" />
              </div>
              <div class="size">
                <label for="size">M</label>
                <input type="text" id="size" name="size" />
              </div>
              <div class="size">
                <label for="size">L</label>
                <input type="text" id="size" name="size" />
              </div>
              <div class="size">
                <label for="size">XL</label>
                <input type="text" id="size" name="size" />
              </div>
              <div class="size">
                <label for="size">XXL</label>
                <input type="text" id="size" name="size" />
              </div>
              <div class="size">
                <label for="size">3XXL</label>
                <input type="text" id="size" name="size" />
              </div>
            </div>
          </div>

          <!-- form-buttons -->
          <div class="form-buttons">
            <button id="submit">SUBMIT</button>
            <button id="reset">RESET</button>
          </div>
        </div>
      </form>
    </section>

    <script src="/admin.js"></script>
  </body>
</html>
