<!doctype html>
<html lang="en">
  <head>
    <%-include("../../partials/head")%>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <%-include("../../partials/header")%>

    <section class="admin-sidebar">
      <div class="admin-sidebar-btn">
        <button id="add-product-section">ADD PRODUCT</button>
        <button id="update-product-section">UPDATE PRODUCT</button>
        <button id="order-details-section">ORDERS</button>
      </div>
    </section>

    <!-- ADD PRODUCT SECTION -->
    <section class="add-product-section">
      <form id="add-product-form" action="#">
        <section class="add-product-img-section">
          <h1>Add Product Images</h1>
          <div class="add-img-div">
            <div class="main-img-div">
              <div class="no-img-div">
                <input type="file" id="file-0" name="file" required />
                <label for="file-0">
                  <i class="bx bx-image-add"></i>Change Image
                </label>
              </div>
              <div class="img-div"></div>
            </div>
            <div class="small-img-div">
              <div class="small-imgs">
                <div class="small-img">
                  <div class="no-img-div">
                    <input type="file" name="file" id="file-1" required />
                    <label for="file-1">
                      <i class="bx bx-image-add"></i>Change Image
                    </label>
                  </div>
                  <div class="img-div"></div>
                </div>
                <div class="small-img">
                  <div class="no-img-div">
                    <label for="file-2">
                      <i class="bx bx-image-add"></i>Change Image
                    </label>
                    <input type="file" id="file-2" name="file" />
                  </div>
                  <div class="img-div"></div>
                </div>
                <div class="small-img">
                  <div class="no-img-div">
                    <label for="file-3">
                      <i class="bx bx-image-add"></i>Change Image
                    </label>
                    <input type="file" id="file-3" name="file" />
                  </div>
                  <div class="img-div"></div>
                </div>
                <div class="small-img">
                  <div class="no-img-div">
                    <label for="file-4">
                      <i class="bx bx-image-add"></i>Change Image
                    </label>
                    <input type="file" id="file-4" name="file" />
                  </div>
                  <div class="img-div"></div>
                </div>
                <div class="small-img">
                  <div class="no-img-div">
                    <label for="file-5">
                      <i class="bx bx-image-add"></i>Change Image
                    </label>
                    <input type="file" id="file-5" name="file" />
                  </div>
                  <div class="img-div"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- product-info-section -->
        <section class="product-info-section">
          <h1 class="heading info-section">PRODUCT INFORMATION</h1>
          <div class="common-info">
            <div class="block block1">
              <div class="product-name width-50per">
                <label for="product-name">Name</label>
                <input type="text" name="name" id="product-name" required />
              </div>
              <div class="product-short-description width-50per">
                <label for="product-short-description">Short Description</label>
                <textarea
                  name="shortDescription"
                  id="product-short-description"
                  required
                ></textarea>
              </div>
            </div>
            <div class="block">
              <div class="product-categories width-50per">
                <div class="main-category">
                  <label for="main-category">Select Category:</label>
                  <select id="main-category" name="category">
                    <option disabled selected value="">
                      Select main category
                    </option>
                  </select>
                </div>
                <div class="sub-category">
                  <label for="sub-category">Select sub category:</label>
                  <select id="sub-category" name="subCategory">
                    <option disabled selected value="">
                      Select sub category
                    </option>
                  </select>
                </div>
              </div>

              <div class="product-sizes width-50per">
                <p id="size-title">Product quantity in size:</p>
                <div class="sizes">
                  <div class="size">
                    <label for="size-xs">XS</label>
                    <input
                      type="text"
                      id="size-xs"
                      class="size-input"
                      name="xs"
                    />
                  </div>
                  <div class="size">
                    <label for="size-s">S</label>
                    <input
                      type="text"
                      id="size-s"
                      class="size-input"
                      name="s"
                    />
                  </div>
                  <div class="size">
                    <label for="size-m">M</label>
                    <input
                      type="text"
                      id="size-m"
                      class="size-input"
                      name="m"
                    />
                  </div>
                  <div class="size">
                    <label for="size-l">L</label>
                    <input
                      type="text"
                      id="size-l"
                      class="size-input"
                      name="l"
                    />
                  </div>
                  <div class="size">
                    <label for="size-xl">XL</label>
                    <input
                      type="text"
                      id="size-xl"
                      class="size-input"
                      name="xl"
                    />
                  </div>
                  <div class="size">
                    <label for="size-xxl">XXL</label>
                    <input
                      type="text"
                      id="size-xxl"
                      class="size-input"
                      name="xxl"
                    />
                  </div>
                  <div class="size">
                    <label for="size-3xl">3XL</label>
                    <input
                      type="text"
                      id="size-3xl"
                      class="size-input"
                      name="threeXl"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="other-info">
            <div class="sell-info width-50per block">
              <div class="sell-checkbox center-checkbox">
                <label for="sell">For Sell</label>
                <input
                  type="checkbox"
                  id="sell"
                  name="forSell"
                  value="true"
                  onchange="toggleAddProductPriceInputElements(event)"
                  required
                />
              </div>
              <div class="sell-more-info">
                <div class="sell-price">
                  <label for="sell-price">Selling price:</label>
                  <input
                    class="price-input"
                    type="text"
                    id="sell-price"
                    name="sellPrice"
                    required
                    pattern="[0-9]+"
                    title="value should be number"
                    disabled
                  />
                </div>
                <div class="sell-description">
                  <label for="sell-main-description">Sell description:</label>
                  <textarea
                    id="sell-main-description"
                    name="sellDescription"
                    class="main-description-textarea"
                    required
                    disabled
                  ></textarea>
                </div>
              </div>
            </div>
            <div class="rent-info width-50per block">
              <div class="rent-checkbox center-checkbox">
                <label for="sell">For Rent</label>
                <input
                  type="checkbox"
                  id="rent"
                  name="forRent"
                  value="true"
                  onchange="toggleAddProductPriceInputElements(event)"
                  required
                />
              </div>
              <div class="rent-more-info">
                <div class="rent-price-div">
                  <div class="rent-price width-50per">
                    <label for="update-product-rent-price"
                      >Rental price per day:</label
                    >
                    <input
                      class="price-input"
                      type="text"
                      id="rent-price"
                      name="rentPrice"
                      required
                      pattern="[0-9]+"
                      title="value should be number"
                      disabled
                    />
                  </div>
                  <div class="rent-deposit-price width-50per">
                    <label for="update-product-deposit-charge"
                      >Deposit Charge:</label
                    >
                    <input
                      class="price-input"
                      type="text"
                      id="deposit-charge"
                      name="depositCharge"
                      required
                      pattern="[0-9]+"
                      title="value should be number"
                      disabled
                    />
                  </div>
                </div>
                <div class="rent-description">
                  <label for="rent-main-description">Rent description:</label>
                  <textarea
                    id="rent-main-description"
                    name="rentDescription"
                    class="main-description-textarea"
                    required
                    disabled
                  ></textarea>
                </div>
              </div>
            </div>
          </div>
          <div class="form-buttons">
            <button id="submit">SUBMIT</button>
            <button
              id="resetBtn"
              type="reset"
              onclick="clearForm('add-product-form',event)"
            >
              RESET
            </button>
          </div>
        </section>
      </form>
    </section>

    <section class="update-product-section">
      <section class="prompt-category">
        <div class="product-category">
          <div class="update-product-main-category">
            <label for="update-product-main-category">Select category:</label>
            <select id="update-product-main-category" name="category"></select>
          </div>

          <div class="update-product-sub-category">
            <label for="update-product-sub-category"
              >Select sub category:</label
            >
            <select id="update-product-sub-category" name="subCategory">
              <option disabled selected value="">
                --Select sub category--
              </option>
            </select>
          </div>
        </div>
        <button id="find-products-to-update">Find</button>
      </section>
      <section class="products-to-update" style="display: none">
        <h1>Update Product Information</h1>
        <button
          class="up-back-btn"
          onclick="u_pGoBackToSection('prompt-category')"
        >
          <i class="bx bx-arrow-back back-button"></i>
        </button>
        <div class="update-product-div">
          <!-- <div class="up-item">
            <img
              class="up-img"
              loading="lazy"
              src="/Images/home-images/home-maternity-gowns/a.jpg"
              alt=""
            />
            <div class="up-item-info">
              <div class="name-price">
                <p class="name"></p>
                <p class="price">Rs. 2000</p>
              </div>
            </div>
          </div> -->
        </div>
      </section>
      <section class="update-product-form-section">
        <button
          class="up-back-btn"
          onclick="u_pGoBackToSection('products-to-update')"
        >
          <i class="bx bx-arrow-back back-button"></i>
        </button>
        <form id="update-product-form" action="#">
          <section class="update-product-img-section">
            <h1>Add Product Images</h1>
            <div class="add-img-div">
              <div class="main-img-div">
                <div class="no-img-div">
                  <input
                    type="file"
                    id="update-product-image-file-0"
                    name="file"
                  />
                  <label for="update-product-image-file-0">
                    <i class="bx bx-image-add"></i>Change Image
                  </label>
                </div>
                <div class="img-div"></div>
              </div>
              <div class="small-img-div">
                <div class="small-imgs">
                  <div class="small-img">
                    <div class="no-img-div">
                      <input
                        type="file"
                        name="file"
                        id="update-product-image-file-1"
                      />
                      <label for="update-product-image-file-1">
                        <i class="bx bx-image-add"></i>Change Image
                      </label>
                    </div>
                    <div class="img-div"></div>
                  </div>
                  <div class="small-img">
                    <div class="no-img-div">
                      <label for="update-product-image-file-2">
                        <i class="bx bx-image-add"></i>Change Image
                      </label>
                      <input
                        type="file"
                        id="update-product-image-file-2"
                        name="file"
                      />
                    </div>
                    <div class="img-div"></div>
                  </div>
                  <div class="small-img">
                    <div class="no-img-div">
                      <label for="update-product-image-file-3">
                        <i class="bx bx-image-add"></i>Change Image
                      </label>
                      <input
                        type="file"
                        id="update-product-image-file-3"
                        name="file"
                      />
                    </div>
                    <div class="img-div"></div>
                  </div>
                  <div class="small-img">
                    <div class="no-img-div">
                      <label for="update-product-image-file-4">
                        <i class="bx bx-image-add"></i>Change Image
                      </label>
                      <input
                        type="file"
                        id="update-product-image-file-4"
                        name="file"
                      />
                    </div>
                    <div class="img-div"></div>
                  </div>
                  <div class="small-img">
                    <div class="no-img-div">
                      <label for="update-product-image-file-5">
                        <i class="bx bx-image-add"></i>Change Image
                      </label>
                      <input
                        type="file"
                        id="update-product-image-file-5"
                        name="file"
                      />
                    </div>
                    <div class="img-div"></div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- product-info-section -->
          <section class="product-info-section">
            <h1 class="heading info-section">PRODUCT INFORMATION</h1>
            <div class="common-info">
              <div class="block block1">
                <div class="product-name width-50per">
                  <label for="product-name">Name</label>
                  <input type="text" name="name" id="product-name" />
                </div>
                <div class="product-short-description width-50per">
                  <label for="product-short-description"
                    >Short Description</label
                  >
                  <textarea
                    name="shortDescription"
                    id="product-short-description"
                  ></textarea>
                </div>
              </div>
              <div class="block">
                <div class="product-categories width-50per">
                  <div class="main-category">
                    <label for="main-category">Select Category:</label>
                    <select id="main-category" name="category">
                      <option disabled selected value="">
                        Select main category
                      </option>
                    </select>
                  </div>
                  <div class="sub-category">
                    <label for="sub-category">Select sub category:</label>
                    <select id="sub-category" name="subCategory">
                      <option disabled selected value="">
                        Select sub category
                      </option>
                    </select>
                  </div>
                </div>

                <div class="product-sizes width-50per">
                  <p id="size-title">Product quantity in size:</p>
                  <div class="sizes">
                    <div class="size">
                      <label for="size-xs">XS</label>
                      <input
                        type="text"
                        id="size-xs"
                        class="size-input"
                        name="xs"
                      />
                    </div>
                    <div class="size">
                      <label for="size-s">S</label>
                      <input
                        type="text"
                        id="size-s"
                        class="size-input"
                        name="s"
                      />
                    </div>
                    <div class="size">
                      <label for="size-m">M</label>
                      <input
                        type="text"
                        id="size-m"
                        class="size-input"
                        name="m"
                      />
                    </div>
                    <div class="size">
                      <label for="size-l">L</label>
                      <input
                        type="text"
                        id="size-l"
                        class="size-input"
                        name="l"
                      />
                    </div>
                    <div class="size">
                      <label for="size-xl">XL</label>
                      <input
                        type="text"
                        id="size-xl"
                        class="size-input"
                        name="xl"
                      />
                    </div>
                    <div class="size">
                      <label for="size-xxl">XXL</label>
                      <input
                        type="text"
                        id="size-xxl"
                        class="size-input"
                        name="xxl"
                      />
                    </div>
                    <div class="size">
                      <label for="size-3xl">3XL</label>
                      <input
                        type="text"
                        id="size-3xl"
                        class="size-input"
                        name="threeXl"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="other-info">
              <div class="sell-info width-50per block">
                <div class="sell-checkbox center-checkbox">
                  <label for="sell">For Sell</label>
                  <input
                    type="checkbox"
                    id="sell"
                    name="forSell"
                    value="true"
                    onchange="toggleUpdateProductPriceInputElements(event)"
                  />
                </div>
                <div class="sell-more-info">
                  <div class="sell-price">
                    <label for="sell-price">Selling price:</label>
                    <input
                      class="price-input"
                      type="text"
                      id="sell-price"
                      name="sellPrice"
                      required
                      pattern="[0-9]+"
                      title="value should be number"
                      disabled
                    />
                  </div>
                  <div class="sell-description">
                    <label for="sell-main-description">Sell description:</label>
                    <textarea
                      id="sell-main-description"
                      name="sellDescription"
                      class="main-description-textarea"
                      required
                    ></textarea>
                  </div>
                </div>
              </div>
              <div class="rent-info width-50per block">
                <div class="rent-checkbox center-checkbox">
                  <label for="sell">For Rent</label>
                  <input
                    type="checkbox"
                    id="rent"
                    name="forRent"
                    value="true"
                    onchange="toggleUpdateProductPriceInputElements(event)"
                    required
                  />
                </div>
                <div class="rent-more-info">
                  <div class="rent-price-div">
                    <div class="rent-price width-50per">
                      <label for="update-product-rent-price"
                        >Rental price per day:</label
                      >
                      <input
                        class="price-input"
                        type="text"
                        id="rent-price"
                        name="rentPrice"
                        required
                        pattern="[0-9]+"
                        title="value should be number"
                        disabled
                      />
                    </div>
                    <div class="rent-deposit-price width-50per">
                      <label for="update-product-deposit-charge"
                        >Deposit Charge:</label
                      >
                      <input
                        class="price-input"
                        type="text"
                        id="deposit-charge"
                        name="depositCharge"
                        required
                        pattern="[0-9]+"
                        title="value should be number"
                        disabled
                      />
                    </div>
                  </div>
                  <div class="rent-description">
                    <label for="rent-main-description">Rent description:</label>
                    <textarea
                      id="rent-main-description"
                      name="rentDescription"
                      class="main-description-textarea"
                    ></textarea>
                  </div>
                </div>
              </div>
            </div>
            <div class="form-buttons">
              <button id="submit">SUBMIT</button>
              <button
                id="resetBtn"
                type="reset"
                onclick="clearForm('add-product-form',event)"
              >
                RESET
              </button>
            </div>
          </section>
        </form>
      </section>
    </section>

    <section class="order-details-section">
      <h1>Order Details</h1>

      <section class="ordered-list-section">
        <div class="order-detail-filters">
          <div class="od-search-filter">
            <label for="search-order-id">Search by:</label>
            <input
              id="search-order-id"
              type="text"
              placeholder="Order id or email"
            />
          </div>

          <div class="od-sort-filter-div">
            <label for="order-sort-by">Sort by:</label>
            <select id="order-sort-by" name="filter">
              <option value="none" selected disabled>select sort by</option>
              <option value="latest">latest</option>
              <option value="oldest">oldest</option>
            </select>

            <label for="order-filter-by">Filter by:</label>
            <select id="order-filter-by" name="filter">
              <option value="none" selected disabled>select filter by</option>
              <option value="complete">complete</option>
              <option value="incomplete">incomplete</option>
            </select>

            <label id="clear-all-label" for="clear-all-btn">Clear all</label>
            <input type="radio" id="clear-all-btn" />
          </div>
        </div>

        <div class="order-details-div">
          <table class="od-table" style="width: 100%">
            <tr>
              <th>S.NO</th>
              <th>ORDER ID</th>
              <th>USER NAME</th>
              <th>USER EMAIL</th>
              <th>DATE</th>
              <th>STATUS</th>
              <th>DETAILS</th>
            </tr>
          </table>
        </div>
      </section>

      <section class="ordered-product-detail-section">
        <div class="ordered-product-detail-div">
          <div class="ordered-user-detail">
            <div class="back-button">
              <i class="bx bx-arrow-back back-button"></i>
            </div>
            <div class="user-order-id">
              <p>Order Id: <span id="order-id"></span></p>
            </div>
            <div class="user-name-phone">></div>
            <div class="user-shipping-address">
              <h4>Shipping Address:</h4>
              <div class="Shipping-address-div"></div>
            </div>
          </div>
          <div class="edit-product-status">
            <button class="edit-product-status-btn">Edit</button>
          </div>
          <div class="ordered-product-detail">
            <table class="product-detail-table">
              <tr>
                <th>S.NO</th>
                <th>PRODUCT</th>
                <th>PRODUCT NAME</th>
                <th>SIZE</th>
                <th>QUANTITY</th>
                <th>STATUS</th>
                <th>OPEN</th>
                <th>UPDATE STATUS</th>
              </tr>
            </table>
          </div>
        </div>
        <div id="update-order-btns" style="display: none">
          <button class="update">Update</button>
          <button class="cancel">Cancel</button>
        </div>
      </section>
    </section>

    <!-- loader -->
    <div class="loader-container">
      <div class="loader"></div>
    </div>

    <div class="confirm-product-delete-div">
      <div class="btns">
        <h3>Do you really want to delete</h3>
        <div>
          <button class="cancel">Cancel</button>
          <button class="delete">Delete</button>
        </div>
      </div>
    </div>

    <script src="/js/wingsestilo.js"></script>
    <script src="/admin.js"></script>
  </body>
</html>
