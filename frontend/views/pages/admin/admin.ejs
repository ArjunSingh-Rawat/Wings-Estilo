            />
            <div class="up-item-info">
              <div class="name-price">
                <p class="name"></p>
                <p class="price">Rs. 2000</p>
              </div>
            </div>
          </div> -->
        </div>
      </section>
      <section class="update-product-form-section">
        <button onclick="u_pGoBackToSection('products-to-update')">
