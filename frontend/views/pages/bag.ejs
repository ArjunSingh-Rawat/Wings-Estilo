<!doctype html>
<html lang="en">
  <head>
    <%-include('../partials/head')%>
    <link rel="stylesheet" href="/css/bag.css" />
  </head>
  <body>
    <%-include('../partials/header')%>

    <section class="bag-section" style="display: none">
      <div class="bag-div">
        <img src="/Images/general-img/bag.png" alt="" />
        <p>Your bag is empty!</p>
        <a href="/">Continue Shopping</a>
      </div>
    </section>

    <section class="bag-item-section" style="display: none">
      <div class="bag-items">
        <div class="item-num">
          <p>TOTAL ITEMS: <span class="total-items"></span></p>
        </div>
        <!-- items -->
        <div class="items"></div>

        <!-- items -->
        <div class="place-order">
          <button>PLACE ORDER</button>
        </div>
      </div>

      <div class="bag-total">
        <P class="price-details">PRICE DETAILS</P>
        <div class="item-price-total">
          <div class="total">
            <p>Price(<span class="total-items"></span> items)</p>
            <p class="total-amount">Rs.00</p>
          </div>
        </div>
        <div class="total-amt">
          <p>Total Amount</p>
          <p class="net-amount">Rs.3000</p>
        </div>
      </div>
    </section>

    <!-- footer -->
    <%- include('../partials/footer') %>
    <script src="/js/bag.js"></script>
  </body>
</html>
