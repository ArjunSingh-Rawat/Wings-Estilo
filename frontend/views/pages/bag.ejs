<!doctype html>
<html lang="en">
  <head>
    <%-include('../partials/head')%>
    <link rel="stylesheet" href="/css/bag.css" />
  </head>
  <body>
    <sectio%-include('../partials/header')%>

    <section class="bag-section">
      <div class="bag-div">
        <img src="/Images/general-img/bag.png" alt="" />
        <p>Your bag is empty!</p>
        <a href="/">Continue Shopping</a>
      </div>
    </section>

    <section class="cart-container cart-page">
      <table>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Subtotal</th>
        </tr>
        <tr>
          <td>
            <div class="cart-info">
              <img src="/Image/gowns/gown-1.jpg" />
              <div>
                <p id="gown">Beautiful blue gown</p>
                <small>1000/-</small>
                <br />
              <button class="remove-btn" onclick="removeItem(1)">Remove</button>
              </div>
            </div>
          </td>
          <td><input type="number" value="1" min="1" /></td>
          <td>1000/-</td>
        </tr>
        <tr>
          <td>
            <div class="cart-info">
              <img src="/Image/gowns/gown-2.jpeg" />
              <div>
                <p id="gown">Beautiful green gown</p>
                <small>1700/-</small>
                <br />
                <button class="remove-btn" onclick="removeItem(2)">Remove</button>
              </div>
            </div>
          </td>
          <td><input type="number" value="1" min="1" /></td>
          <td>1700/-</td>
        </tr>
        <tr>
          <td>
            <div class="cart-info">
              <img src="/Image/gowns/gown-3.jpeg" />
              <div>
                <p id="gown">Beautiful Flair blue gown</p>
                <small>1500/-</small>
                <br />
                <button class="remove-btn" onclick="removeItem(3)">Remove</button>
              </div>
            </div>
          </td>
          <td><input type="number" value="1" min="1" /></td>
          <td>1500/-</td>
        </tr>
      </table>

      <!-- Subtotal Prices -->

      <div class="total-price">
        <table>
          <tr>
            <td>Subtotal</td>
            <td>1200</td>
          </tr>
          <tr>
            <td>Tax</td>
            <td>100</td>
          </tr>
          <tr>
            <td>Total</td>
            <td>1300</td>
          </tr>
        </table>
      </div>
    </section>
    
  </body>
</html>
