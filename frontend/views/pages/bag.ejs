<!doctype html>
<html lang="en">
  <head>
    <%-include('../partials/head')%>
    <link rel="stylesheet" href="/css/bag.css" />
  </head>
  <body>
    <%-include('../partials/header')%>

    <section class="bag-section" style="display: none">
      <div class="bag-div">
        <img src="/Images/general-img/bag.png" alt="" />
        <p>Your bag is empty!</p>
        <a href="/">Continue Shopping</a>
      </div>
    </section>

    <section class="bag-item-section">
      <div class="bag-items">
        <div class="item-num">
          <p>TOTAL ITEMS: <span>3</span></p>
        </div>
        <!-- items -->
        <div class="items">
          <div class="item">
            <div class="item-img">
              <img src="/Images/gowns/gown-1.jpg" alt="" />
            </div>
            <div class="item-details">
              <p class="item-name">Red flare Ball Gown</p>
              <p class="item-price">Rs.1200</p>
              <div class="item-buttons">
                <div class="quantity-button">
                  <button class="q-minus">-</button>
                  <p class="q-number">3</p>
                  <button class="q-plus">+</button>
                </div>
                <button class="remove-button">REMOVE</button>
              </div>
            </div>
          </div>
        </div>

        <!-- items -->
        <div class="place-order">
          <button>PLACE ORDER</button>
        </div>
      </div>

      <div class="bag-total">
        <P class="price-details">PRICE DETAILS</P>
        <div class="item-price-total">
          <div class="total">
            <p>Price(3 items)</p>
            <p>Rs.3000</p>
          </div>
          <div class="dc">
            <p>Delivery Charges</p>
            <p>Rs.80</p>
          </div>
        </div>
        <div class="total-amt">
          <p>Total Amount</p>
          <p>Rs.3000</p>
        </div>
      </div>
    </section>
  </body>
</html>
