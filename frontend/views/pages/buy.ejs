<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <link rel="stylesheet" href="/css/product-page.css" />
    <title>Product buy page</title>
  </head>
  <body>
    <%- include("../partials/header") %>
    <section class="product-section">
      <div class="product">
        <div class="product-small-img">
          <img
            src="/carousel/images/product1.png"
            alt=""
            onclick="myFunction(this)"
          />
          <img
            src="/carousel/images/product2.png"
            alt=""
            onclick="myFunction(this)"
          />
          <img
            src="/carousel/images/product3.png"
            alt=""
            onclick="myFunction(this)"
          />
          <img
            src="/carousel/images/product4.png"
            alt=""
            onclick="myFunction(this)"
          />
          <img
            src="/carousel/images/product1.png"
            alt=""
            onclick="myFunction(this)"
          />
        </div>

        <div class="img-container">
          <img id="imageBox" src="/carousel/images/product1.png" alt="" />
        </div>
      </div>

      <div class="product-info">
        <p class="brand-name">Wings Estilo</p>
        <h1 class="product-name">Wings Estilo Gown name</h1>
        <p class="product-short-description">Dress short description</p>
        <p class="product-price">Rs. 3,990</p>

        <div class="product-size-div">
          <div class="size-chart">
            <p>Size</p>
            <a href="#">Size Chart</a>
          </div>

          <div class="sizes">
            <ul>
              <li class="active">S</li>
              <li>M</li>
              <li>L</li>
              <li>XL</li>
              <li>XXL</li>
            </ul>
          </div>
        </div>

        <div class="add-button">
          <button class="wishlist-btn">
            <i class="bx bx-heart"></i>
          </button>
          <button class="add-to-cart-btn">ADD TO CART</button>
          <button class="buy-now-btn">BUY NOW</button>
        </div>

        <div class="product-detail">
          <details>
            <summary>DESCRIPTION</summary>
            <p>
              Lorem ipsum dolor, sit amet consectetur adipisicing elit. Aperiam
              hic corporis voluptate ducimus esse accusantium, sint dicta
              praesentium cupiditate! Voluptatem rerum consequuntur amet sunt
              consectetur corrupti sint illo, repudiandae cupiditate!
            </p>
          </details>
          <details>
            <summary>WASH CARE</summary>
            <p>Dry clean only!</p>
          </details>
          <details>
            <summary>SHIPPING INFORMATION</summary>
            <p>
              Lorem ipsum dolor, sit amet consectetur adipisicing elit. Aperiam
              hic corporis voluptate ducimus esse accusantium, sint dicta
              praesentium cupiditate! Voluptatem rerum consequuntur amet sunt
              consectetur corrupti sint illo, repudiandae cupiditate!
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="more-product-section">
      <h1>More in Gowns</h1>
      <div class="more-product-div">
        <div class="more-product-item">
          <a class="more-product-img" href="#">
            <img src="/carousel/images/item1.png" alt="" />
          </a>
          <div class="more-product-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
              <p class="price">Rs. 2000</p>
            </div>

            <i class="bx bx-heart"></i>
          </div>
        </div>
        <div class="more-product-item">
          <a class="more-product-img" href="#">
            <img src="/carousel/images/item2.png" alt="" />
          </a>
          <div class="more-product-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
              <p class="price">Rs. 2000</p>
            </div>

            <i class="bx bx-heart"></i>
          </div>
        </div>
        <div class="more-product-item">
          <a class="more-product-img" href="#">
            <img src="/carousel/images/item3.png" alt="" />
          </a>
          <div class="more-product-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
              <p class="price">Rs. 2000</p>
            </div>

            <i class="bx bx-heart"></i>
          </div>
        </div>
        <div class="more-product-item">
          <a class="more-product-img" href="#">
            <img src="/carousel/images/item4.png" alt="" />
          </a>
          <div class="more-product-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
              <p class="price">Rs. 2000</p>
            </div>

            <i class="bx bx-heart"></i>
          </div>
        </div>
      </div>
    </section>

    <!-- footer -->
    <%- include('../partials/footer') %>

    <script>
      function myFunction(smallImg) {
        let fullImg = document.getElementById("imageBox");
        fullImg.src = smallImg.src;
      }
    </script>
    <script src="/js/buypage.js"></script>
  </body>
</html>
