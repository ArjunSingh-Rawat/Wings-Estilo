<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Order Summary</title>
    <link rel="stylesheet" href="/css/checkout.css" />
  </head>
  <body>
    <%-include("../partials/header") %>

    <section class="checkout-section">
      <div class="checkout-detail">
        <div class="delivery-address-div">
          <div class="da-title-change">
            <p id="delivery-address-titie">DELIVERY ADDRESS</p>
            <button id="add-change-address-button"></button>
          </div>
          <p id="delivery-address"></p>
        </div>

        <div class="ordered-product-div">
          <% let i = 0 %> <% for(const productData of products) { %> <% const
          product = productData.product %> <% for(const {productSize,quantity}
          of productData.productSizesAndQuantity) { %>
          <div
            id="item<%=i%>"
            class="ordered-product"
            data-product-id="<%= product._id %>"
            data-product-size="<%=productSize%>"
            data-product-quantity="<%=quantity%>"
          >
            <img
              class="ordered-product-img"
              src="<%=product.image%>"
              alt="<%=product.name%>"
            />
            <div class="ordered-product-detail">
              <p id="ordered-product-name"><%=product.name%></p>
              <p id="ordered-product-price">Rs. <%=product.sellPrice%></p>
              <p id="ordered-product-size">
                Size: <span><%=productSize%></span>
              </p>

              <div class="quantity-remove-btn">
                <div class="quantity-btn" data-item-id="item<%=i%>">
                  <button class="q-minus quantity-toggle">-</button>
                  <p class="product-quantity"><%=quantity%></p>
                  <button class="q-plus quantity-toggle">+</button>
                </div>
              </div>
            </div>
          </div>
          <% i++ %> <% } %> <% } %>
        </div>

        <div class="checkout-continue-div">
          <p id="checkout-confirmation-email">
            Order confirmation email will be sent to
            <span id="user-email">......</span>
          </p>
          <button id="checkout-continue-btn">CONTINUE</button>
        </div>
      </div>

      <div class="checkout-price-detail">
        <P class="price-details">PRICE DETAILS</P>
        <div class="item-price-total">
          <div class="total">
            <p>Price(<span class="total-items">0</span> items)</p>
            <p class="total-amount">Rs.00</p>
          </div>
          <div class="dc">
            <p>Delivery Charges</p>
            <p>Rs.80</p>
          </div>
        </div>
        <div class="total-amt">
          <p>Total Amount</p>
          <p class="net-amount">Rs. 00</p>
        </div>
      </div>
    </section>

    <%- include("../partials/footer") %>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="/js/checkout.js"></script>
  </body>
</html>
