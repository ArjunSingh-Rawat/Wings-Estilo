<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>CONTACT US | WINGS ESTILO</title>
    <meta
      name="description"
      content="Explore our exclusive boutique for renting and buying a wide range of gowns, maternity gowns, dresses, lehengas, party wears, tiaras, and more. Perfect for every occasion—shop or rent now and elevate your style! Discover high-quality fashion at affordable prices"
    />
    <link rel="stylesheet" href="/css/contact.css" />

    <!-- Google font -->
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include("../partials/header") %>

    <section class="contact-us-section">
      <h1>CONTACT US</h1>

      <div class="contact-boxes">
        <div>
          <i class="bx bxs-envelope"></i>
          <h3>Email Us</h3>
          <p>Wingsestilo@gmail.com</p>
        </div>
        <div>
          <i class="bx bxs-phone-call"></i>
          <h3>Contact Us</h3>
          <p>9171167503, 8770616089</p>
        </div>
        <div>
          <i class="bx bxs-time"></i>
          <h3>Our Timings</h3>
          <p>Mon-Fri: 11:30 AM - 8:30 PM</p>
        </div>
      </div>
    </section>

    <section class="shop-section">
      <div class="shop-img">
        <img src="/Images/general-img/shop.png" alt="" />
      </div>
      <div class="shop-info">
        <h2 id="h2-1">Our Shop</h2>
        <h2 id="h2-2">Wing's Estilo - Gwalior, Madhya Pradesh</h2>
        <p>
          5, Shoping center, Fort Rd, near Sai Baba Mandir Road, Kherapati
          Colony, Phool Bagh, Lashkar, Gwalior, Madhya Pradesh 474002
        </p>
        <p>Email: Wingsestilo@gmail.com</p>
        <p>Phone: 9171167503, 8770616089</p>
      </div>
    </section>

    <section class="google-map-section">
      <div class="google-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3579.3473445652335!2d78.16906131141671!3d26.21790117697254!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3976c7ec67287ea7%3A0xc40f6c79ade088ef!2sWing&#39;s%20Estilo%20-%20Customise%20Boutique%20%2F%20Rental%20Dresses%20(Dresses%20on%20Rent)!5e0!3m2!1sen!2sin!4v1706373066859!5m2!1sen!2sin"
          width="100%"
          height="500"
          style="border: 0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>

    <%- include("../partials/footer") %>
