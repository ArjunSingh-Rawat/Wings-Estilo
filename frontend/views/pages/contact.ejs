<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Document</title>
    <link rel="stylesheet" href="/css/contact.css" />

    <!-- Google font -->
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <%- include("../partials/header") %>
    <h1 class="contact">CONTACT US</h1>
    <p class="para">
      We'd love to hear from you! If you have any questions or comments for us,
      fill out the form below we will get back to you within 24 hours. Or feel
      free to write us at support@wingsestilo.com or call us at +91-8770616089.
      We are available to take your calls on 24hrs.
    </p>

    <div class="box1">
      <div class="market">
        <p>Manufactured, Packed & Marketed By:</p>
        <p>WingsEstilo Gwalior, 474002</p>
      </div>

      <div class="address">
        <p>Address</p>
        <p>Near Sai Baba Mandir Gwalior (M.P.)</p>
      </div>
    </div>
    <div class="box2">
      <div class="phone">
        <p>Customer Support</p>
        <p>8770616089, 9171167503</p>
      </div>

      <div class="address">
        <p>Email</p>
        <p>support@wingsestilo.com</p>
      </div>
    </div>

    <h1 class="contact">CONTACT</h1>

    <section>
      <div class="container">
        <form action="#" method="post">
          <label for="name">Name:</label>
          <input type="text" id="name" name="name" required />

          <label for="email">Email:</label>
          <input type="email" id="email" name="email" required />

          <label for="phone">Phone Number:</label>
          <input type="tel" id="phone" name="phone" required />

          <label for="message">Message:</label>
          <textarea id="message" name="message" rows="4" required></textarea>

          <button class="submit-btn" type="submit">Submit</button>
        </form>
      </div>

      <h1 class="map">GOOGLE MAP</h1>
      <div class="google-map">
        <p>
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3579.3473445652335!2d78.16906131141671!3d26.21790117697254!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3976c7ec67287ea7%3A0xc40f6c79ade088ef!2sWing&#39;s%20Estilo%20-%20Customise%20Boutique%20%2F%20Rental%20Dresses%20(Dresses%20on%20Rent)!5e0!3m2!1sen!2sin!4v1706373066859!5m2!1sen!2sin"
            width="80%"
            height="500"
            style="border: 0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </p>
      </div>
    </section>
    <%- include("../partials/footer") %>
  </body>
</html>
