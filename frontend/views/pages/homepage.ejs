        </div>
      </div>

      <div class="follow-div">
        <a
          class="follow-btn"
          href="https://www.instagram.com/wings.estilo/"
          target="_blank"
        >
          <i class="bx bxl-instagram"></i>
          Follow on Instagram
        </a>
