        <div class="home-gowns-item">
          <a class="home-gown-img" href="#">
            <img src="/Images/home-images/home-gowns/d.png" alt="" />
          </a>
          <div class="item-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
              <p class="price">Rs. 2000</p>
            </div>

            <i class="bx bx-heart"></i>
          </div>
        </div>
      </div>

      <div class="viewAll-btn">
        <a href="/sell/gowns">View All</a>
      </div>
    </section>

    <!-- video-section -->

    <section class="video-section">
      <h1>Take a Glace at</h1>
      <h2>OUR TRENDING COLLECTION</h2>
      <div class="videos">
        <video
          src="/Images/home-images/videos/1.mp4"
          autoplay
          muted
          loop
        ></video>
        <video
          src="/Images/home-images/videos/2.mp4"
          autoplay
          muted
          loop
        ></video>
        <video
          src="/Images/home-images/videos/3.mp4"
