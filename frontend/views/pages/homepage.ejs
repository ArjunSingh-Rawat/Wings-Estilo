<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title>Wings Estilo</title>

    <script src="/js/carousel.js"></script>
    <link rel="stylesheet" href="/css/wingsestilo-home.css" />
  </head>
  <body>
    <!-- HEADER  -->
    <%- include('../partials/header') %>

    <!-- carousel -->
    <div class="img-slider">
      <a href="">
        <img src="/Images/home-images/carousel-images/gown.png" alt="" />
      </a>
      <a href="">
        <img src="/Images/home-images/carousel-images/dress.png" alt="" />
      </a>
      <a href="">
        <img src="/Images/home-images/carousel-images/sarees.png" alt="" />
      </a>
      <a href="/photoshoot">
        <img src="/Images/home-images/carousel-images/photoshoot.png" alt="" />
      </a>
    </div>

    <!-- category-section -->

    <section class="category-section">
      <h1>Shop by Category</h1>
      <div class="categories">
        <a class="category" href="/sell/gowns">
          <img src="/Images/home-images/categories/1.png" alt="" />
          <span>Gowns</span>
        </a>
        <a class="category" href="/sell/dresses">
          <img src="/Images/home-images/categories/2.png" alt="" />
          <span>Dresses</span>
        </a>
        <a class="category" href="/rent/lehenga">
          <img src="/Images/home-images/categories/3.png" alt="" />
          <span>Lehenga</span>
          <span class="category-rental">Rental</span>
        </a>
        <a class="category" href="/rent/sarees">
          <img src="/Images/home-images/categories/4.png" alt="" />
          <span>Sarees</span>
          <span class="category-rental">Rental</span>
        </a>
        <!-- <a class="category" href="/kids">
          <img src="/Images/home-images/categories/5.png" alt="" />
          <p>Kids</p>
        </a> -->
        <a class="category" href="/sell/accessories">
          <img src="/Images/home-images/categories/6.png" alt="" />
          <span>Accessories</span>
        </a>
      </div>
    </section>

    <!-- Home Gowns -->

    <section class="home-gown-section">
      <h1>Get Decorated With Our</h1>
      <h2>GOWNS</h2>

      <div class="home-gowns">
        <div class="home-gowns-item">
          <a class="home-gown-img" href="#">
            <img src="/Images/home-images/home-gowns/a.png" alt="" />
          </a>
          <div class="item-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
              <p class="price">Rs. 2000</p>
            </div>

            <i class="bx bx-heart"></i>
          </div>
        </div>
        <div class="home-gowns-item">
          <a class="home-gown-img" href="#">
            <img src="/Images/home-images/home-gowns/b.png" alt="" />
          </a>
          <div class="item-info">
            <div class="name-price">
              <a class="name" href="#">Wings estilo gown name</a>
