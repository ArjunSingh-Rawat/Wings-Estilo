<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <link rel="stylesheet" href="/css/wingsestilo-home.css" />
  </head>
  <body>
    <!-- HEADER  -->
    <%- include('../partials/header') %>

    <!-- HOME SECTION -->

    <section class="home-section">
      <div class="home-img-div">
        <img src="/Images/home-img/home-banner.png" alt="" />
      </div>
    </section>

    <!-- CATEGORY SECTION -->

    <section class="category-section">
      <div class="ct-h1">
        <h1>Shop by Category</h1>
      </div>

      <div class="ct-grid">
        <a href="ws-gowns.html" class="ct">
          <img src="/Images/category-img/gowns.jpg" alt="" />
          <p class="ct-p">GOWNS<br /><span>Shop now</span></p>
        </a>
        <a href="#" class="ct">
          <img src="/Images/category-img/dresses.jpeg" alt="" />
          <p class="ct-p">DRESSES<br /><span>Shop now</span></p>
        </a>
        <a href="ws-sarees.html" class="ct">
          <img src="/Images/category-img/sarees.jpeg" alt="" />
          <p class="ct-p">SAREES<br /><span>Shop now</span></p>
        </a>
        <a href="ws-lehenga.html" class="ct">
          <img src="/Images/category-img/lehengas.jpeg" alt="" />
          <p class="ct-p">LEHENGA<br /><span>Shop now</span></p>
        </a>
        <a href="ws-mgowns.html" class="ct">
          <img src="/Images/category-img/maternity-gowns.jpg" alt="" />
          <p class="ct-p">MATERNITY GOWNS<br /><span>Shop now</span></p>
        </a>
        <a href="ws-kids.html" class="ct">
          <img src="/Images/category-img/kids.jpeg" alt="" />
          <p class="ct-p">KIDS<br /><span>Shop now</span></p>
        </a>
      </div>
    </section>

    <!-- RENTAL-SECTION -->

    <section class="rental-section">
      <div class="rental-banner">
        <img src="/Images/home-img/rental-banner.png" alt="" />
      </div>
      <div class="rental-grid">
        <div class="rental-div">
          <div class="r-img">
            <img src="/Images/home-img/home-rental1.jpeg" alt="" />
          </div>
          <div class="r-info">
            <div class="name">
              <p>Dress Name</p>
            </div>
            <div class="add">
              <i class="bx bx-heart heart"></i>
            </div>
          </div>
        </div>
        <div class="rental-div">
          <div class="r-img">
            <img src="/Images/home-img/home-rental2.jpg" alt="" />
          </div>
          <div class="r-info">
            <div class="name">
              <p>Dress Name</p>
            </div>
            <div class="add">
              <i class="bx bx-heart heart"></i>
            </div>
          </div>
        </div>
        <div class="rental-div">
          <div class="r-img">
            <img src="/Images/home-img/home-rental3.jpg" alt="" />
          </div>
          <div class="r-info">
            <div class="name">
              <p>Dress Name</p>
            </div>
            <div class="add">
              <i class="bx bx-heart heart"></i>
            </div>
          </div>
        </div>
        <div class="rental-div">
          <div class="r-img">
            <img src="/Images/home-img/home-rental4.jpeg" alt="" />
          </div>
          <div class="r-info">
            <div class="name">
              <p>Dress Name</p>
            </div>
            <div class="add">
              <i class="bx bx-heart heart"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="rental-viewall">
        <a href="#">VIEW ALL</a>
      </div>
    </section>

    <!-- ACCESSORIES-SECTION -->

    <section class="accessories-section">
      <div class="a-banner">
        <img
          src="/Images/home-img/accessories-banner.png"
          alt=""
          width="100%"
        />
      </div>
      <div class="rental-grid">
        <div class="rental-div">
          <div class="r-img">
            <img src="/Images/home-img/a-img1.png" alt="" />
          </div>
          <div class="r-info">
            <div class="name">
              <p>Dress Name</p>
            </div>
            <div class="add">
              <i class="bx bx-heart heart"></i>
            </div>
          </div>
        </div>
        <div class="rental-div">
          <div class="r-img">
            <img src="/Images/home-img/a-img2.png" alt="" />
          </div>
          <div class="r-info">
            <div class="name">
              <p>Dress Name</p>
            </div>
            <div class="add">
              <i class="bx bx-heart heart"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="rental-viewall">
        <a href="#">VIEW ALL</a>
      </div>
    </section>
