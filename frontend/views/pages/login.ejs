<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include("../partials/head") %>
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
        />
        <link rel="stylesheet" href="/css/login.css" />
    </head>
    <body>
        <%- include("../partials/header") %>

        <form id="form1">
            <h1 class="head">Login</h1>
            <input
                style="color: black"
                class="test"
                type="email"
                placeholder="Email"
                required
                name="email"
                id="email"
            />
            <br />
            <br />
            <input
                style="color: black"
                class="test"
                type="password"
                placeholder="password"
                required
                name="password"
                id="password"
            />
            <br />
            <br />
            <input type="checkbox" name="check" id="check" />
            <label class="test1" for="check"
                >I agree to the Terms and Condition</label
            >
            <button id="btn">Login</button>
            <br />
            <br />
            <a style="text-decoration: none" href="#">Forgot password?</a>
            <p style="color: #5c4343">
                Don't have an account?
                <a href="file:///C:/Users/ACE/Downloads/Signup/signup.html"
                    >Signup</a
                >
            </p>
            <p>Or</p>
            <div class="social-icon">
                <a href="https:www.instagram.com" target="_blank"
                    ><i class="fab fa-instagram"></i
                ></a>
                <a href="https:www.facebook.com" target="_blank"
                    ><i class="fab fa-facebook"></i
                ></a>
            </div>
        </form>
        <script>
            const loginForm = document.querySelector("#form1");

            loginForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const loginCredentials = {
                email: document.querySelector("#email").value,
                password: document.querySelector("#password").value
            };

            const msg = await fetch("/api/users/login", {
                method: "POST",
                headers: {
                "Content-Type": "application/json",
                },
                body: JSON.stringify(loginCredentials),
            });

            if (msg.ok) {
                const data = await msg.json();
                console.log(data);
                window.location.href = "/";
            } else {
                document.querySelector("#msg").innerHTML = "Failed";
            }
            });

        </script>
    </body>
</html>
