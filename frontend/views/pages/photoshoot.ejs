<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head")%>
    <link rel="stylesheet" href="/css/photoshoot.css" />
    <title>Document</title>
  </head>
  <body>
    <%- include("../partials/header")%>
    <section class="maternity-photoshoot-section">
      <div class="m-hero-img">
        <img src="/Images/photoshoot/maternity-photoshoot.jpg" alt="" />
      </div>
      <div class="m-hero-img-res">
        <img src="/Images/photoshoot/maternity-photoshoot1.jpg" alt="" />
      </div>
    </section>

    <section class="photoshoot-form-section">
      <form action="" class="photoshoot-form">
        <div class="pf-box1">
          <label for="fname">Full name:</label>
          <input type="text" id="fname" name="fname" />
        </div>

        <div class="pf-box2">
          <label for="email">Enter your email:</label>
          <input type="email" id="email" name="email" />
        </div>

        <div class="pf-box3">
          <label for="phone">Phone number:</label>
          <input type="text" id="phone" name="phone" />
        </div>

        <div class="pf-box4">
          <label for="address">Adress:</label>
          <textarea id="address" name="address"> </textarea>
        </div>

        <input id="pf-submit-button" type="submit" value="Submit" />
      </form>

      <div class="pf-img-div">
        <img src="/Images/photoshoot/maternity-img1.jpg" alt="" />
      </div>
    </section>
    <!-- faq -->
    <section class="FAQ-section">
      <h1 class="faq">FREQUENTLY ASKED QUESTIONS</h1>

      <div class="questions">
        <button class="accordion">When should I do baby bump shoot?</button>
        <div class="panel">
          <p class="faq-para">
            The best time to plan for the pre baby shoot is after the 7th month
            i.e. the start of the 8th month or 32nd week of pregnancy. Though
            the best time is inbetween 34th-36th week. For twin pregnancy
            photoshoot 7.5 month or 30th week is ideal.
          </p>
        </div>

        <button class="accordion">
          Where will our Maternity Photoshoot in Gwalior take place?
        </button>
        <div class="panel">
          <p class="faq-para">
            The location of Photoshoot Studio will be.<br /><br />
            Near Sai Baba Mandir, Infront of Vishal Mega Mart, Fort Road,
            PhoolBagh Gwalior(M.P.)
          </p>
        </div>

        <button class="accordion">Do you provide Maternity dress?</button>
        <div class="panel">
          <p class="faq-para">
            Yes, We do have a beautiful collection of dresses or Gowns and
            accessories for the expecting mothers kept hygienically at our
            studio.<br /><br />
            You are also welcomed to bring any of yours to be used as a
            maternity photoshoot dress.
          </p>
        </div>
        <button class="accordion">
          What shall I wear for Maternity pictures?
        </button>
        <div class="panel">
          <p class="faq-para">
            We provide Maternity Photoshoot Gowns, dresses, Sarees, and Western
            Dresses in which you will be comfortable.
          </p>
        </div>
        <button class="accordion">
          How many types of maternity photoshoots do we provide?
        </button>
        <div class="panel">
          <p class="faq-para">
            We provide two types of Maternity Photoshoot, one is Indoor
            Maternity Photoshoot and the other is Outdoor Maternity Photoshoot.
          </p>
        </div>

        <button class="accordion">
          When will we receiving our Maternity Photoshoot Pics?
        </button>
        <div class="panel">
          <p class="faq-para">
            It generally takes 7-10 Working days post the Maternity Photoshoot
            to handover final pics.
          </p>
        </div>
      </div>
    </section>

    <!-- Baby photoshoot  -->
    <!-- footer -->
    <%- include('../partials/footer') %>

    <!-- FAQ js -->
    <script>
      var acc = document.getElementsByClassName("accordion");
      var i;

      for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
          this.classList.toggle("active");
          var panel = this.nextElementSibling;
          if (panel.style.maxHeight) {
            panel.style.maxHeight = null;
          } else {
            for (var j = 0; j < acc.length; j++) {
              if (acc[j] !== this && acc[j].classList.contains("active")) {
                acc[j].classList.remove("active");
                acc[j].nextElementSibling.style.maxHeight = null;
              }
            }
            panel.style.maxHeight = panel.scrollHeight + "px";
          }
        });
      }
    </script>
  </body>
</html>
