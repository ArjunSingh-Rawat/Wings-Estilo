<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <title><%= rentOrSell === 'sell'?"buy":"rent"%> <%=name%> | <%=shortDescription%> for <%= rentOrSell === 'sell'?"sell":"rent"%> | WINGS ESTILO</title>
    <meta
    name="description"
    content="<%=description%>"
  />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
  <link rel="stylesheet" href="/css/product-page.css" />
  </head>
  <body>
    <%- include("../partials/header") %>
    <section class="product-section">
      <div class="product">
        <div class="product-small-img">
          <img
              src="<%= image %>"
              alt=""
              onclick="myFunction(this)"
            />
          <% for(let i=0; i<images.length; i++){ %>
          
            <img
              src="<%= images[i]%>"
              alt=""
              onclick="myFunction(this)"
            />
            <% } %>
        </div>

        <div class="img-container">
          <img id="imageBox" src="<%= image %>" alt="" />
        </div>
      </div>

      <div class="swiper product-slider">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <div class="swiper-zoom-container">
                <img src="<%= image %>" alt="<%= name + " | " + shortDescription%>">
              </div>
              <div class="zoom-icon" onclick="toggleZoom()">
                <i class='bx bx-zoom-in'></i>
                <i class='bx bx-zoom-out' style="display: none;"></i>
              </div>
            </div>
            <% for(let i=0; i<images.length; i++){ %>
                <div class="swiper-slide">
                  
                  <div class="swiper-zoom-container">
                    <img 
                    src="<%= images[i]%>"
                    alt="<%= name + " | " + shortDescription%>"
                    />
                  </div>
                  <div class="zoom-icon" onclick="toggleZoom()">
                    <i class='bx bx-zoom-in'></i>
                    <i class='bx bx-zoom-out' style="display: none;"></i>
                  </div>
                </div>
             
              <% } %> 
            </div>
            <div class="swiper-pagination"></div>
      </div>
      <div class="product-info">
        <p class="brand-name">Wings Estilo</p>
        <h1 class="product-name"><%= name %></h1>
        <p class="product-short-description"><%= shortDescription %></p>
        <p class="product-price">Rs. <% if (rentOrSell === 'sell') { %>
            <%= sellPrice %>
          <% } else { %>
            <%= rentPrice %><span>/day</span>
          <% } %>
        </p>

        <div class="product-size-div">
          <div class="size-chart">
            <p>Size</p>
            <a href="#">Size Chart</a>
          </div>

          <div class="sizes">
            <ul>
              <li>XS</li>
              <li>S</li>
              <li>M</li>
              <li>L</li>
              <li>XL</li>
              <li>XXL</li>
            </ul>
          </div>
        </div>
        <div class="add-button" data-product-id="<%= _id %>">
          <button class="wishlist-btn">
            <% if(isProductInWishlist){ %>
              <i class="heart bx bxs-heart"></i>
              <% } else { %>
                <i class="heart bx bx-heart"></i>
            <% } %>
          </button>
          <% if (rentOrSell === 'sell') { %>
            <button class="add-to-bag-btn">ADD TO BAG</button>
          <% } %>
          <% if (rentOrSell === 'sell') { %>
            <button class="buy-now-btn">BUY NOW</button>
            <% } else { %>
              <button class="rent-now-btn">RENT NOW</button>
          <% } %>
        </div>

        <div class="product-detail">
          
          <button class="accordion">DESCRIPTION</button>
            <div class="panel" id="description">
                <p><%= description %></p>
            </div>

          <button class="accordion">WASH CARE</button>
            <div class="panel">
                <p>
                    Dry clean only!
                </p>
            </div>

          <button class="accordion">SHIPPING INFORMATION</button>
          <div class="panel">
              <p>
                We endeavor to provide a pleasant and zero-hassle shopping experience for you. All our policies and terms of use are crafted to ensure ease of purchase and support. We request you to thoroughly review them and make informed purchases.
              </p>
              <p>We at WingsEstilo, understand the importance of delivering your products timely and safely. Therefore, we partner with some of the most reputed Indian Courier partner such as Bluedart, Delhivery, DHL etc., to ensure seamless delivery of all orders.</p>
          </div>
          
        </div>


      </div>
    </section>

    <section class="more-product-section" style="display: none;">
      <h1>SIMILAR PRODUCTS</h1>
      <div class="more-product-div"></div>
    </section>

    <!-- footer -->
    <%- include('../partials/footer') %>
    <script>
      // image change
      function myFunction(smallImg) {
        let fullImg = document.getElementById("imageBox");
        fullImg.src = smallImg.src;
      }

      // accordion
      const productAccordion = document.getElementsByClassName("accordion");
      for (let i = 0; i < productAccordion.length; i++) {
        productAccordion[i].addEventListener("click", function() {
              this.classList.toggle("des-active");
              var panel = this.nextElementSibling;
              if (panel.style.maxHeight) {
                  panel.style.maxHeight = null;
              } else {
                  panel.style.maxHeight = panel.scrollHeight + "px";
              }
          });
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <% if (rentOrSell === 'sell') { %>
      <script src="/js/product.js"></script>
      <% } else { %>
        <script src="/js/rentProduct.js"></script>
    <% } %>
  </body>
</html>
