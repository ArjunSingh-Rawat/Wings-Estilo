<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <link rel="stylesheet" href="/css/ws-all.css" />
  </head>
  <body>
    <%- include("../partials/header") %>

    <section class="dress-section">
      <div class="filter-sidebar">
        <div class="filters">
          <p id="filter-title">FILTERS</p>
          <p id="clear-all">Clear all</p>
        </div>

        <button class="accordion">PRICE</button>
        <div class="panel">
          <div class="select-filter">
            <input
              type="radio"
              id="1000"
              name="fav_language"
              value="500-1000"
            />
            <label for="1000">500-1000</label><br />

            <input
              type="radio"
              id="2000"
              name="fav_language"
              value="1000-2000"
            />
            <label for="2000">1000-2000</label><br />

            <input
              type="radio"
              id="3000"
              name="fav_language"
              value="2000-3000"
            />
            <label for="3000">2000-3000</label><br />

            <input
              type="radio"
              id="4000"
              name="fav_language"
              value="3000-4000"
            />
            <label for="4000">3000-4000</label><br />

            <input
              type="radio"
              id="5000"
              name="fav_language"
              value="4000-5000"
            />
            <label for="5000">4000-5000</label><br />
          </div>
        </div>
      </div>

      <div class="dress-div">
        <div class="dress-title">
          <h1><%= categoryName %></h1>
          <p class="total-products">40 Products</p>
        </div>

        <div class="dress-grid"></div>
      </div>
    </section>

    <!-- footer -->
    <%- include('../partials/footer') %>

    <!-- accordion js -->
    <script>
      var acc = document.getElementsByClassName("accordion");
      var i;

      for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
          this.classList.toggle("active");
          var panel = this.nextElementSibling;
          if (panel.style.maxHeight) {
            panel.style.maxHeight = null;
          } else {
            panel.style.maxHeight = panel.scrollHeight + "px";
          }
        });
      }
    </script>

    <script src="/js/products.js"></script>
  </body>
</html>
