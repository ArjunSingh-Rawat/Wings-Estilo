<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <link rel="stylesheet" href="/css/products.css" />
  </head>
  <body>
    <%- include("../partials/header") %>

    <section class="dress-section">
      <div class="title-and-filter">
        <div class="dress-title">
          <h1><%= categoryName %></h1>
        </div>
        <div class="filter"></div>
      </div>
      <div class="dress-grid">
        <% for(product of products) { %>
          <% const productName = product.name.replace(/ /g, "-") %>
          <% const price = rentOrSell === "sell" ? product.sellPrice : product.rentPrice %>
          <% const priceSuffix = rentOrSell === "rent" ? "/day" : "" %>
          <div class="item">
            <a class="item-img" href=<%= `/${rentOrSell}/${productName}/${product._id}/buy` %> >
              <img loading="lazy" src="<%= product.image %>" alt="<%= productName %>" />
            </a>
            <div class="item-info">
                <div class="name-price">
                  <a class="name" href=<%=`/${rentOrSell}/${productName}/${product._id}/buy`%> target = "_blank"><%= product.name %></a>
                  <p class="price">&#8377;<span><%= price %><span><%= priceSuffix %></span></p>
                </div>
    
                <div class="add">
                  <i class="bx bx-heart heart" data-product-id="<%=product._id%>"></i>
                </div>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <section class="product-pages">
      <% for(let i = 1; i< totalPages + 1; i++){ %>
        <span><%=i%></span>
      <% } %>
    </section>

    <div class="pagination">
      <button class="btn1"><i class='bx bx-left-arrow-alt'></i></button>
      <ul>
        <li class="link activePage" value="1">1</li>
        <li class="link" value="2">2</li>
        <li class="link" value="3">3</li>
        <li class="link" value="4">4</li>
        <li class="link" value="5">5</li>
      </ul>
      <button class="btn2"><i class='bx bx-right-arrow-alt'></i></button>
    </div>
    <!-- footer -->
    <%- include('../partials/footer') %>

    <!-- accordion js -->
    <script>
      var acc = document.getElementsByClassName("accordion");
      var i;

      for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
          this.classList.toggle("filter-active");
          var panel = this.nextElementSibling;
          if (panel.style.maxHeight) {
            panel.style.maxHeight = null;
          } else {
            panel.style.maxHeight = panel.scrollHeight + "px";
          }
        });
      }
    </script>

    <script src="/js/products.js"></script>
  </body>
</html>
