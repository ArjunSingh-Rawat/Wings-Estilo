<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <link rel="stylesheet" href="/css/profile.css" />
  </head>
  <body>
    <%- include("../partials/header") %>

    <section class="profile">
      <!-- sidebar -->

      <section class="profile-sidebar">
        <div class="profile-div">
          <div class="user-img">
            <img src="/Images/profile-images/profile-picture.png" alt="" />
          </div>
          <div class="user-info">
            <p id="user-name"></p>
            <p id="user-email"></p>
          </div>
        </div>

        <div class="profile-nav">
          <button id="profile-section" class="nav">
            <img src="/Images/profile-images/my-profile.png" alt="" />
            <span>My Profile</span>
          </button>
          <button id="orders-section" class="nav">
            <img src="/Images/profile-images/my-orders.png" alt="" />
            <span>My Orders</span>
          </button>
          <button id="addresses-section" class="nav">
            <img src="/Images/profile-images/my-addresses.png" alt="" />
            <span>My Addresses</span>
          </button>
        </div>

        <button class="logout-btn" onclick="logout()">Logout</button>
      </section>

      <!-- right-sections -->

      <section class="my-profile-section" style="display: none">
        <h2>MY PROFILE</h2>
        <div class="my-profile-info">
          <div class="personal-info info">
            <div class="pi-title">
              <p class="p">PERSONAL INFORMATION</p>
              <p id="personal-info-edit" class="edit-btn">Edit</p>
              <p id="personal-info-save" class="edit-btn" style="display: none">
                Save
              </p>
            </div>

            <div class="first-name info-div">
              <label for="fname">First name:</label>
              <input
                type="text"
                id="fname"
                name="firstName"
                value=""
                disabled
              />
            </div>

            <div class="last-name info-div">
              <label for="lname">Last name:</label>
              <input type="text" id="lname" name="lastName" value="" disabled />
            </div>

            <div class="gender">
              <p id="gender-title">Gender:</p>
              <div class="gender">
                <input
                  type="radio"
                  id="male"
                  name="gender"
                  value="male"
                  disabled
                />
                <label for="male">Male</label>
                <input
                  type="radio"
                  id="female"
                  name="gender"
                  value="female"
                  disabled
                />
                <label for="female">Female</label>
              </div>
              <p id="gender-field-alert" class="alert" style="display: none">
                ! Please fill out this field
              </p>
            </div>
          </div>

          <div class="email-info info">
            <div class="ei-title">
              <p class="p">EMAIL ADDRESS</p>
            </div>

            <div class="email-div info-div">
              <label for="email">Email:</label>
              <input type="email" id="email" name="email" value="" disabled />
            </div>
          </div>

          <div class="contact-info info">
            <div class="ci-title">
              <p class="p">MOBILE NUMBER</p>
              <p id="phone-number-edit" class="edit-btn">Edit</p>
              <p id="phone-number-save" class="edit-btn" style="display: none">
                Save
              </p>
            </div>

            <div class="number info-div">
              <label for="fname">Mobile Number:</label>
              <input
                type="text"
                id="phone-number"
                name="phoneNumber"
                value="+91"
                disabled
              />
              <p id="number-field-alert" class="alert" style="display: none">
                ! Please fill out this field
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- my-orders-section -->
      <section class="my-orders-section" style="display: none">
        <!-- no-orders-div -->
        <div class="no-orders-div" style="display: none">
          <p id="no-p1">No orders has been placed yet</p>
          <p id="no-p2">Add items into your cart to place an order</p>
          <button
            class="continue-shopping-btn"
            onclick="window.location.href='/'"
          >
            CONTINUE SHOPPING
          </button>
        </div>

        <!-- orders-div -->
        <div class="orders-div" style="display: none">
          <h2>MY ORDERS</h2>
          <div class="orders-list"></div>
        </div>
      </section>

      <!-- address-section -->
      <section class="my-addresses-section" style="display: flex">
        <!-- no-address-div -->
        <div class="no-address-div" style="display: none">
          <p id="no-p1">No Address added yet</p>
          <p id="no-p2">
            Click “Add Address” button below to add your delivery address
          </p>
          <button class="add-new-address-btn">ADD NEW ADDRESS</button>
        </div>

        <div class="address-container">
          <p id="address-title">MANAGE ADDRESSES</p>
          <div class="address-div"></div>
          <button class="add-new-address-btn">ADD NEW ADDRESS</button>
        </div>

        <!-- address-form-->

        <div class="add-new-address-div" style="display: none">
          <p class="add-title">ADD NEW ADDRESS</p>

          <form class="address-form" action="#">
            <div class="box1">
              <div class="name">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="mobile-number">
                <label for="mobile-number">10-digit mobile number:</label>
                <input
                  type="text"
                  id="mobile-number"
                  name="phoneNumber"
                  maxlength="10"
                  minlength="10"
                  pattern="[0-9]+"
                  required
                />
              </div>
            </div>

            <div class="box2">
              <div class="pincode">
                <label for="pincode">Pincode:</label>
                <input
                  type="text"
                  id="pincode"
                  name="pinCode"
                  maxlength="6"
                  minlength="6"
                  pattern="[0-9]+"
                  required
                />
              </div>

              <div class="locality">
                <label for="locality">Locality:</label>
                <input
                  type="text"
                  id="locality"
                  name="addressLine2"
                  autocomplete="address-line2"
                  required
                />
              </div>
            </div>

            <div class="box3">
              <label for="textarea">Address (Area and Street)</label>
              <textarea
                id="textarea"
                name="addressLine1"
                autocomplete="address-level1"
                required
              ></textarea>
            </div>

            <div class="box4">
              <div class="city">
                <label for="city">District:</label>
                <input
                  type="text"
                  id="city"
                  name="district"
                  autocomplete="address-level2"
                  required
                />
              </div>

              <div class="state">
                <label for="state">State:</label>
                <select
                  id="state"
                  name="state"
                  autocomplete="address-level1"
                  required
                >
                  <option value="volvo">--Select State--</option>
                  <option value="Andaman And Nicobar Islands">
                    Andaman And Nicobar Islands
                  </option>
                  <option value="Andhra Pradesh">Andhra Pradesh</option>
                  <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                  <option value="Assam">Assam</option>
                  <option value="Bihar">Bihar</option>
                  <option value="Chandigarh">Chandigarh</option>
                  <option value="Chhattisgarh">Chhattisgarh</option>
                  <option value="Delhi">Delhi</option>
                  <option value="Goa">Goa</option>
                  <option value="Gujarat">Gujarat</option>
                  <option value="Haryana">Haryana</option>
                  <option value="Himachal Pradesh">Himachal Pradesh</option>
                  <option value="Jammu And Kashmir">Jammu And Kashmir</option>
                  <option value="Jharkhand">Jharkhand</option>
                  <option value="Karnataka">Karnataka</option>
                  <option value="Kerala">Kerala</option>
                  <option value="Ladakh">Ladakh</option>
                  <option value="Lakshadweep">Lakshadweep</option>
                  <option value="Madhya Pradesh">Madhya Pradesh</option>
                  <option value="Maharashtra">Maharashtra</option>
                  <option value="Manipur">Manipur</option>
                  <option value="Meghalaya">Meghalaya</option>
                  <option value="Mizoram">Mizoram</option>
                  <option value="Nagaland">Nagaland</option>
                  <option value="Odisha">Odisha</option>
                  <option value="Puducherry">Puducherry</option>
                  <option value="Punjab">Punjab</option>
                  <option value="Rajasthan">Rajasthan</option>
                  <option value="Sikkim">Sikkim</option>
                  <option value="Tamil Nadu">Tamil Nadu</option>
                  <option value="Telangana">Telangana</option>
                  <option value="The Dadra And Nagar Haveli And Daman And Diu">
                    The Dadra And Nagar Haveli And Daman And Diu
                  </option>
                  <option value="Tripura">Tripura</option>
                  <option value="Uttarakhand">Uttarakhand</option>
                  <option value="Uttar Pradesh">Uttar Pradesh</option>
                  <option value="West Bengal">West Bengal</option>
                </select>
              </div>
            </div>

            <div class="form-btn">
              <p id="form-alerts" style="display: none"></p>
              <button id="save-btn" type="submit">SAVE</button>
              <button id="cancel-btn">CANCEL</button>
            </div>
          </form>
        </div>
      </section>
    </section>

    <div id="otp-container">
      <div id="otp-popup">
        <div onclick="showOtpCloseConfirm()" class="close-btn">&times;</div>
        <div class="verify-otp">VERIFY OTP</div>
        <div class="otp-value-container">
          <div class="primary-otp">
            <div class="enter-otp">
              Enter OTP sent on +91 <span class="primary-number"></span>
            </div>
            <div class="otp-values">
              <input id="p-0" type="text" maxlength="1" />
              <input id="p-1" type="text" maxlength="1" />
              <input id="p-2" type="text" maxlength="1" />
              <input id="p-3" type="text" maxlength="1" />
              <input id="p-4" type="text" maxlength="1" />
              <input id="p-5" type="text" maxlength="1" />
            </div>
          </div>
          <div class="update-otp">
            <div class="enter-otp">
              Enter OTP sent on +91 <span class="update-number"></span>
            </div>
            <div class="otp-values">
              <input id="u-0" type="text" maxlength="1" />
              <input id="u-1" type="text" maxlength="1" />
              <input id="u-2" type="text" maxlength="1" />
              <input id="u-3" type="text" maxlength="1" />
              <input id="u-4" type="text" maxlength="1" />
              <input id="u-5" type="text" maxlength="1" />
            </div>
          </div>
          <div class="otp-errors"></div>
        </div>
        <div class="otp-not-rec">
          OTP not received? <span class="resend-otp">resend</span> in 60sec
        </div>
        <button onclick="submitOtp()" id="otp-submit-btn">Submit</button>

        <div class="confirm-close-otp" style="display: none">
          <div onclick="closeConfirmDiv()" class="close-confirm-btn">
            &times;
          </div>
          <p>Next you will be able to edit after 10 minutes</p>
          <button onclick="closeOtpDiv();clearOtpInputValues()">Confirm</button>
        </div>
      </div>
    </div>
    <!-- footer -->
    <%- include('../partials/footer') %>

    <script src="/js/profile.js"></script>
  </body>
</html>
