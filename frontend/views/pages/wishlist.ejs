            <i class="bx bx-x"></i>
          </div>
          <div class="img-info">
            <p class="item-name">Red ball gown</p>
            <p class="item-price">Rs.2000 <del>Rs.1999</del></p>
            <button class="move-btn">Move to bag</button>
