<!doctype html>
<html lang="en">
  <head>
    <%-include('../partials/head')%>
    <link rel="stylesheet" href="/css/wishlist.css" />
  </head>
  <body>
    <%-include('../partials/header')%>

    <section class="wishlist-section">
      <div class="wishlist-div">
        <p id="save">
          Log in to save your whishlist
          <a id="login" href="">Log in/Sign up.</a>
        </p>
        <img src="Images/general-img/wishlist.png" alt="" />
        <p id="title">Your wishlist is empty!</p>
        <a id="continue-shopping" href="/">Continue Shopping</a>
      </div>
    </section>

