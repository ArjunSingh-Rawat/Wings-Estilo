<!doctype html>
<html lang="en">
  <head>
    <%-include('../partials/head')%>
    <link rel="stylesheet" href="/css/wishlist.css" />
  </head>
  <body>
    <%-include('../partials/header')%>

    <section class="wishlist-section">
      <div class="wishlist-div">
        <p id="save">
          Log in to save your whishlist
          <a id="login" href="">Log in/Sign up.</a>
        </p>
        <img src="Images/general-img/wishlist.png" alt="" />
        <p id="title">Your wishlist is empty!</p>
        <a id="continue-shopping" href="/">Continue Shopping</a>
      </div>
    </section>

    <!-- Wishlist -->
    <section class="whishlist-item-section" style="display: none">
      <div class="wishlist-item-num">
        <p class="w-num">My Wishlist <span id="total-items">3 Items</span></p>
      </div>

      <div class="wishlist-items"></div>
    </section>

    <!-- footer -->
    <%- include('../partials/footer') %>

    <script src="/js/wishlist.js"></script>
  </body>
</html>
