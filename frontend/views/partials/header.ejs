<script>
  //enable hidden nav bar

  const nav = document.querySelector(".main-header");
  let lastScrollY = window.scrollY;

  window.addEventListener("scroll", () => {
    if (lastScrollY < window.scrollY && window.scrollY > 130) {
      nav.classList.add("nav-hidden");
    } else {
      nav.classList.remove("nav-hidden");
    }

    lastScrollY = window.scrollY;
  });

  // hamburger
  const hamburger = document.querySelector(".hamburger");
  const mobileNav2 = document.querySelector(".mobile-nav2");

  hamburger.addEventListener("click", () => {
    hamburger.classList.toggle("active");
    mobileNav2.classList.toggle("active");

    if (hamburger.classList.contains("active")) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "auto";
    }
  });

  document.querySelectorAll(".nav-link").forEach((n) =>
    n.addEventListener("click", () => {
      hamburger.classList.remove("active");
      nav2.classList.remove("active");
    })
  );

  // mobile-nav2
  var acc = document.getElementsByClassName("header-accordion");
  var i;

  for (i = 0; i < acc.length; i++) {
    acc[i].addEventListener("click", function () {
      this.classList.toggle("activate");
      var panel = this.nextElementSibling;
      if (panel.style.maxHeight) {
        panel.style.maxHeight = null;
      } else {
        for (var j = 0; j < acc.length; j++) {
          if (acc[j] !== this && acc[j].classList.contains("activate")) {
            acc[j].classList.remove("activate");
            acc[j].nextElementSibling.style.maxHeight = null;
          }
        }
        panel.style.maxHeight = panel.scrollHeight + "px";
      }
    });
  }
</script>

