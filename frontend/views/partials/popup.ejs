<div class="popup" id="popup-1">
  <div class="overlay"></div>
  <div class="content">
    <div class="close-btn" onclick="togglePopup()">&times;</div>

    <div class="popup-content">
      <div class="popup-info">
        <img
          id="popup-logo"
          src="/Images/home-images/icons/wingsEstilo-logo.png"
          alt=""
        />

        <p id="popup-title">SIGN IN/SIGN UP</p>
        <P id="via-google">via google account</P>

        <button class="google-btn" tabindex="1">
          <img
            src="/Images/general-img/google-symbol.png"
            alt=""
            loading="lazy"
          />
          Continue with Google
        </button>
      </div>
    </div>
  </div>
</div>

<!-- alert popup -->
<div id="alert-popup" class="alert-popup hidden">
  <span class="alert-message"></span>
</div>
